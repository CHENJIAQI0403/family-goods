<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.familygoods.mapper.CategoryMapper">

    <select id="selectAll" resultType="com.example.familygoods.entity.GoodsCategory">
        SELECT id, name, create_time FROM goods_category ORDER BY id ASC
    </select>

    <select id="selectById" resultType="com.example.familygoods.entity.GoodsCategory">
        SELECT id, name, create_time FROM goods_category WHERE id = #{id}
    </select>

    <select id="selectByName" resultType="com.example.familygoods.entity.GoodsCategory">
        SELECT id, name, create_time FROM goods_category WHERE name = #{name}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO goods_category(name) VALUES(#{name})
    </insert>

    <update id="update">
        UPDATE goods_category SET name = #{name} WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM goods_category WHERE id = #{id}
    </delete>

</mapper>
